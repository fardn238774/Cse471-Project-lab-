const stage = document.getElementById('stageWrap');
const canvasHost = document.getElementById('canvasHost');
const loadingEl = document.getElementById('loading');
const loadingTextEl = document.getElementById('loadingText');
const flashEl = document.getElementById('flash');

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x000000);
scene.fog = new THREE.Fog(0x000000, 10, 22);

const camera = new THREE.PerspectiveCamera(32, stage.clientWidth/stage.clientHeight, 0.01, 100);

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(stage.clientWidth, stage.clientHeight);
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.28;
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.shadowMap.enabled = true;
canvasHost.appendChild(renderer.domElement);

const pmrem = new THREE.PMREMGenerator(renderer);
scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.14).texture;

const hemi = new THREE.HemisphereLight(0xffffff, 0x3a3b42, 0.9);
scene.add(hemi);
const key = new THREE.DirectionalLight(0xffffff, 1.75);
key.position.set(5, 7, 4);
key.castShadow = true;
key.shadow.mapSize.set(1024,1024);
scene.add(key);
const fill = new THREE.DirectionalLight(0xffffff, 1.3);
fill.position.set(-5, 3, -4);
scene.add(fill);

// The floor reflection re-renders the whole scene a second time into this
// texture every single frame, so its resolution matters a lot for
// performance. It only needs to look like a soft, blurry studio-floor
// reflection - not a crisp mirror - so we deliberately keep it modest
// (capped, and based on the actual 3D viewport rather than the full
// browser window) instead of matching the main render resolution.
const reflectorRes = Math.min(1024, stage.clientWidth, stage.clientHeight * 1.4);
const reflector = new Reflector(new THREE.CircleGeometry(14, 64), {
  clipBias: 0.003,
  textureWidth: reflectorRes,
  textureHeight: reflectorRes,
  color: 0x151515,
});
reflector.rotation.x = -Math.PI/2;
reflector.position.y = 0;
scene.add(reflector);

const groundShadow = new THREE.Mesh(
  new THREE.CircleGeometry(14, 64),
  new THREE.ShadowMaterial({ opacity:0.5 })
);
groundShadow.rotation.x = -Math.PI/2;
groundShadow.position.y = 0.002;
groundShadow.receiveShadow = true;
scene.add(groundShadow);

// Glowing white neon-tube frame around the car, like a studio light rig -
// this is the actual light-shape look we're matching, not a flat overlay.
const barMat = new THREE.MeshStandardMaterial({ color:0x0a0a0a, emissive:0xffffff, emissiveIntensity:3.2, roughness:0.35 });
function addBar(length, x, y, z, rotY, rotZ){
  const bar = new THREE.Mesh(new THREE.BoxGeometry(length, 0.055, 0.055), barMat);
  bar.position.set(x, y, z);
  bar.rotation.y = rotY;
  bar.rotation.z = rotZ;
  scene.add(bar);
}
addBar(9, 0, 3.6, -3, 0.5, 0.3);
addBar(8, 0, 2.4, -3.5, -0.6, -0.25);
addBar(7.5, 0, 4.6, 2.5, 0.9, 0.15);
addBar(8.5, 0, 1.6, 3, -0.4, -0.35);
addBar(6.5, 0, 5.2, 0, 0.2, 0.5);
addBar(7, 0, 1.0, -2.5, -0.8, 0.4);
addBar(6, 0, 5.6, 3.5, 0.7, -0.2);

// Tighter, shorter bars in close around the car itself, like the ones that
// nearly touch the body in the reference shot, rather than only forming a
// distant backdrop frame.
addBar(4.5, 0, 1.7, -1.6, 0.55, 0.32);
addBar(4, 0, 1.1, 1.7, -0.5, -0.3);
addBar(5, 0, 2.4, -1.3, 0.35, 0.22);
addBar(3.6, 0, 0.7, 1.4, -0.7, 0.28);
addBar(5.2, 0, 3.0, 1.6, 0.3, -0.4);
addBar(4, 0, 0.55, -1.8, -0.3, 0.5);
