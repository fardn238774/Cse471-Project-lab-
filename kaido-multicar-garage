const finishPresets = {
  gloss:    { roughness:0.35, metalness:0.05, clearcoat:1.0, clearcoatRoughness:0.05, envMapIntensity:1.0 },
  matte:    { roughness:0.85, metalness:0.0,  clearcoat:0.0, clearcoatRoughness:0.0,  envMapIntensity:0.6 },
  metallic: { roughness:0.35, metalness:0.75, clearcoat:0.3, clearcoatRoughness:0.25, envMapIntensity:1.1 },
  chrome:   { roughness:0.12, metalness:1.0,  clearcoat:1.0, clearcoatRoughness:0.08, envMapIntensity:2.8 },
};

function applyFinish(type){
  const p = finishPresets[type];
  paintMaterials.forEach(m => {
    m.roughness = p.roughness;
    m.metalness = p.metalness;
    m.envMapIntensity = p.envMapIntensity;
    if (m.isMeshPhysicalMaterial){
      m.clearcoat = p.clearcoat;
      m.clearcoatRoughness = p.clearcoatRoughness;
    }
    m.needsUpdate = true;
  });
}

window.setFinish = function(type, btn, price){
  document.getElementById('finishRow').querySelectorAll('.finish-btn').forEach(b => b.classList.remove('active'));
  if(btn) btn.classList.add('active');
  currentFinish = type;
  currentFinishPrice = price || 0;
  applyFinish(type);
  updateRating();
  updatePriceDisplay();
};

function updateRating(){
  let score = 1;
  if (currentFinish !== 'gloss') score++;
  if (currentPaintPrice > 0) score++;
  const bars = document.querySelectorAll('#ratingBars i');
  bars.forEach((b,i) => b.classList.toggle('on', i < score));
}

function updatePriceDisplay(){
  document.getElementById('paintPriceRow').textContent = fmtBDT(currentPaintPrice);
  document.getElementById('finishPriceRow').textContent = currentFinishPrice === 0 ? 'Included' : fmtBDT(currentFinishPrice);
  document.getElementById('totalPriceRow').textContent = fmtBDT(currentPaintPrice + currentFinishPrice);
}

