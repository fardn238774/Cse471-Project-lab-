<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KAIDO GARAGE — Multi-Car Configurator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --line:#2a2e35; --line-soft:#1a1d22;
    --panel:rgba(14,15,18,0.82); --panel-solid:#0e0f12;
    --cyan:#00e5ff; --text:#eef1f5; --text-dim:#8992a0;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{ height:100%; overflow:hidden; }
  body{
    background:#000; color:var(--text);
    font-family:'Rajdhani',sans-serif;
  }

  .stage{
    position:relative; width:100vw; height:100vh; overflow:hidden;
    background:#000; cursor:grab;
  }
  .stage:active{ cursor:grabbing; }
  #canvasHost{ position:absolute; inset:0; z-index:1; }

  .vignette{
    position:absolute; inset:0; z-index:2; pointer-events:none;
    background:radial-gradient(ellipse at center, transparent 45%, rgba(0,0,0,0.75) 100%);
  }

  #loading{
    position:absolute; inset:0; z-index:20; display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:.6rem; background:#000;
    font-family:'Archivo Black',sans-serif; font-size:.85rem; letter-spacing:.1em; color:var(--cyan);
  }
  .loadbar{ width:220px; height:3px; background:var(--line); overflow:hidden; }
  .loadbar span{ display:block; height:100%; width:40%; background:var(--cyan); animation:load 1.1s ease-in-out infinite; }
  @keyframes load{ 0%{transform:translateX(-100%);} 100%{transform:translateX(350%);} }

  .flash{
    position:absolute; inset:0; z-index:15; pointer-events:none;
    background:radial-gradient(circle, rgba(255,255,255,0.55), transparent 60%);
    opacity:0;
  }
  .flash.go{ animation:flashpop .45s ease-out; }
  @keyframes flashpop{ 0%{opacity:.9;} 100%{opacity:0;} }

  .topbar{
    position:absolute; top:0; left:0; right:0; z-index:10;
    display:flex; justify-content:space-between; align-items:center;
    padding:1.1rem 1.6rem;
    background:linear-gradient(180deg, rgba(0,0,0,0.75), transparent);
  }
  .logo{ font-family:'Archivo Black',sans-serif; font-size:1.15rem; letter-spacing:.03em; }
  .logo span{ color:var(--cyan); }
  .hud-chip{
    font-size:.72rem; letter-spacing:.1em; color:var(--text-dim); text-transform:uppercase;
    border:1px solid var(--line); padding:.35rem .8rem; border-radius:2px;
    background:rgba(10,11,14,0.5);
  }
  .rating-wrap{ display:flex; align-items:center; gap:.6rem; }
  .rating-bars{ display:flex; gap:3px; }
  .rating-bars i{ width:6px; height:14px; background:var(--line); border-radius:1px; display:block; }
  .rating-bars i.on{ background:var(--cyan); box-shadow:0 0 6px rgba(0,229,255,0.6); }

  .sidebar{
    position:absolute; top:80px; left:0; bottom:110px; z-index:10;
    width:290px; padding:1.2rem 1.3rem; overflow-y:auto;
    background:var(--panel); backdrop-filter:blur(10px);
    border-right:1px solid var(--line);
  }
  .sidebar::-webkit-scrollbar{ width:5px; }
  .sidebar::-webkit-scrollbar-thumb{ background:var(--line); }

  .sb-section{ margin-bottom:1.5rem; }
  .sb-section h3{
    font-family:'Archivo Black',sans-serif; font-size:.72rem; letter-spacing:.12em;
    color:var(--text-dim); text-transform:uppercase; margin-bottom:.8rem;
  }
  .swatch-row{ display:flex; gap:.55rem; flex-wrap:wrap; }
  .swatch{
    width:32px; height:32px; border-radius:50%; cursor:pointer; position:relative;
    border:2px solid transparent; transition:transform .15s, border-color .15s;
  }
  .swatch:hover{ transform:scale(1.08); }
  .swatch.active{ border-color:var(--cyan); box-shadow:0 0 12px rgba(0,229,255,0.5); }
  .swatch-price{
    position:absolute; bottom:-18px; left:50%; transform:translateX(-50%);
    font-size:.58rem; color:var(--text-dim); white-space:nowrap;
  }

  .custom-color-row{ display:flex; align-items:center; gap:.7rem; margin-top:1.4rem; }
  input[type="color"]{
    -webkit-appearance:none; width:32px; height:32px; border:2px solid var(--line); border-radius:50%;
    background:none; cursor:pointer; padding:0; overflow:hidden;
  }
  input[type="color"]::-webkit-color-swatch-wrapper{ padding:0; }
  input[type="color"]::-webkit-color-swatch{ border:none; border-radius:50%; }
  .custom-label{ font-size:.74rem; color:var(--text-dim); letter-spacing:.03em; }

  .slider-block{ margin-top:1rem; }
  .slider-block label{ display:flex; justify-content:space-between; font-size:.72rem; color:var(--text-dim); letter-spacing:.05em; text-transform:uppercase; margin-bottom:.5rem; }
  .slider-block label span{ color:var(--cyan); font-weight:700; }
  input[type="range"]{
    -webkit-appearance:none; width:100%; height:3px; background:var(--line); border-radius:2px; outline:none;
  }
  input[type="range"]::-webkit-slider-thumb{
    -webkit-appearance:none; width:14px; height:14px; border-radius:50%; background:var(--cyan);
    cursor:pointer; box-shadow:0 0 8px rgba(0,229,255,0.6);
  }

  .finish-row{ display:flex; gap:.5rem; flex-wrap:wrap; }
  .finish-btn{
    background:rgba(255,255,255,0.03); border:1px solid var(--line); color:var(--text-dim);
    font-weight:600; letter-spacing:.04em; text-transform:uppercase;
    font-size:.7rem; padding:.5rem .7rem; cursor:pointer; border-radius:3px; transition:all .15s;
    display:flex; flex-direction:column; align-items:flex-start; gap:.25rem;
  }
  .finish-btn:hover, .finish-btn.active{ border-color:var(--cyan); color:var(--text); }
  .finish-btn-top{ display:flex; align-items:center; gap:.4rem; }
  .finish-swatch{ width:12px; height:12px; border-radius:50%; display:inline-block; }
  .finish-price{ font-size:.63rem; color:var(--text-dim); }

  .part-row{ display:flex; gap:.55rem; flex-wrap:wrap; }
  .part-chip{
    flex:1 1 auto; min-width:112px; background:rgba(255,255,255,0.03); border:1px solid var(--line);
    border-radius:4px; padding:.6rem .7rem; cursor:pointer; transition:all .15s;
  }
  .part-chip:hover{ border-color:var(--line); }
  .part-chip.active{ border-color:var(--cyan); box-shadow:0 0 10px rgba(0,229,255,0.25); }
  .part-chip-name{ font-size:.72rem; font-weight:700; color:var(--text); letter-spacing:.02em; }
  .part-chip-tag{ font-size:.62rem; color:var(--text-dim); margin-top:.2rem; }
  .part-chip.disabled{ cursor:not-allowed; opacity:.45; }

  .price-box{
    background:rgba(255,255,255,0.03); border:1px solid var(--line); border-radius:5px;
    padding:.9rem 1rem;
  }
  .price-row{ display:flex; justify-content:space-between; font-size:.76rem; color:var(--text-dim); margin-bottom:.5rem; }
  .price-row span:last-child{ color:var(--text); font-weight:600; }
  .price-total{
    display:flex; justify-content:space-between; padding-top:.6rem; margin-top:.3rem;
    border-top:1px solid var(--line); font-size:.88rem; font-weight:700;
  }
  .price-total span:last-child{ color:var(--cyan); }
  .confirm-btn{
    width:100%; margin-top:1rem; padding:.8rem; border:none; border-radius:4px;
    background:var(--cyan); color:#031014; font-family:'Archivo Black',sans-serif;
    font-size:.78rem; letter-spacing:.06em; text-transform:uppercase; cursor:pointer;
    transition:background .15s;
  }
  .confirm-btn:hover{ background:#33ecff; }

  .camera-hud{
    position:absolute; top:80px; right:1.4rem; z-index:10;
    display:flex; flex-direction:column; gap:.5rem; align-items:flex-end;
  }
  .angle-row{ display:flex; gap:.4rem; }
  .angle-btn{
    background:var(--panel); border:1px solid var(--line); color:var(--text-dim);
    font-weight:600; letter-spacing:.06em; text-transform:uppercase;
    font-size:.7rem; padding:.5rem .8rem; cursor:pointer; border-radius:3px; transition:all .15s;
    backdrop-filter:blur(8px);
  }
  .angle-btn:hover, .angle-btn.active{ border-color:var(--cyan); color:var(--text); }
  .spin-toggle{
    display:flex; align-items:center; gap:.5rem; font-size:.72rem; color:var(--text-dim);
    cursor:pointer; user-select:none; background:var(--panel); border:1px solid var(--line);
    padding:.4rem .7rem; border-radius:3px; backdrop-filter:blur(8px);
  }
  .spin-dot{ width:8px; height:8px; border-radius:50%; background:var(--line); transition:background .2s; }
  .spin-dot.on{ background:var(--cyan); box-shadow:0 0 8px var(--cyan); }

  .carousel-wrap{
    position:absolute; bottom:0; left:0; right:0; z-index:10;
    padding:1rem 1.4rem 1.2rem;
    background:linear-gradient(0deg, rgba(0,0,0,0.85), transparent);
  }
  .carousel-label-row{
    display:flex; align-items:center; justify-content:space-between; margin-bottom:.6rem;
  }
  .carousel-label{
    font-size:.7rem; letter-spacing:.12em; color:var(--text-dim); text-transform:uppercase;
  }
  .carousel-arrows{ display:flex; gap:.5rem; }
  .carousel-arrow{
    width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    background:var(--panel); border:1px solid var(--line); color:var(--text-dim);
    font-size:.8rem; cursor:pointer; transition:all .15s; backdrop-filter:blur(8px);
  }
  .carousel-arrow:hover:not(:disabled){ border-color:var(--cyan); color:var(--text); }
  .carousel-arrow:disabled{ opacity:.3; cursor:default; }
  .carousel-viewport{ overflow:hidden; }
  .carousel{
    display:flex; gap:.8rem; transition:transform .35s cubic-bezier(.4,0,.2,1); will-change:transform;
  }
  .build-card{
    flex:0 0 auto; width:150px; background:var(--panel); border:1px solid var(--line);
    border-radius:5px; padding:.7rem; cursor:pointer; transition:border-color .15s, transform .15s;
    backdrop-filter:blur(8px);
  }
  .build-card:hover{ transform:translateY(-2px); border-color:var(--line); }
  .build-card.active{ border-color:var(--cyan); box-shadow:0 0 14px rgba(0,229,255,0.25); }
  .build-swatch{ width:100%; height:34px; border-radius:3px; margin-bottom:.55rem; }
  .car-swatch{
    display:flex; align-items:center; justify-content:center;
    font-family:'Archivo Black',sans-serif; font-size:.85rem; color:#fff; letter-spacing:.02em;
  }
  .build-name{ font-size:.78rem; font-weight:700; color:var(--text); letter-spacing:.02em; }
  .build-tag{ font-size:.68rem; color:var(--text-dim); margin-top:.15rem; }
  .view-btn{
    margin-top:.6rem; width:100%; padding:.4rem 0; cursor:pointer;
    background:rgba(0,229,255,0.08); border:1px solid var(--cyan); color:var(--cyan);
    font-family:'Rajdhani',sans-serif; font-size:.66rem; font-weight:700; letter-spacing:.06em;
    text-transform:uppercase; border-radius:3px; transition:all .15s;
  }
  .view-btn:hover{ background:var(--cyan); color:#031014; }

  .exit-view-btn{
    display:none; position:absolute; top:80px; left:1.4rem; z-index:11;
    background:var(--panel); border:1px solid var(--cyan); color:var(--cyan);
    padding:.6rem 1rem; border-radius:4px; font-size:.72rem; letter-spacing:.05em;
    text-transform:uppercase; cursor:pointer; backdrop-filter:blur(8px);
  }
  body.view-mode .exit-view-btn{ display:block; }
  body.view-mode .sidebar{ display:none; }
  body.view-mode .credit{ left:1.4rem; }

  .credit{
    position:absolute; bottom:1.1rem; left:305px; z-index:10;
    font-size:.64rem; color:rgba(137,146,160,0.75); line-height:1.5; max-width:460px;
  }
  .credit a{ color:var(--cyan); }

  /* Payment modal */
  .modal-overlay{
    position:fixed; inset:0; z-index:100; background:rgba(0,0,0,0.82);
    display:none; align-items:center; justify-content:center; padding:1.5rem;
  }
  .modal-overlay.active{ display:flex; }
  .modal{
    background:#0e0f12; border:1px solid var(--line); border-radius:6px;
    width:100%; max-width:440px; padding:1.8rem; position:relative;
  }
  .modal-close{
    position:absolute; top:1rem; right:1rem; background:none; border:none;
    color:var(--text-dim); font-size:1.3rem; cursor:pointer; line-height:1;
  }
  .modal-close:hover{ color:var(--text); }
  .modal-eyebrow{
    font-family:'Archivo Black',sans-serif; font-size:.68rem; color:var(--cyan);
    text-transform:uppercase; letter-spacing:.1em; margin-bottom:.6rem;
  }
  .modal h3{ font-family:'Archivo Black',sans-serif; font-size:1.2rem; margin-bottom:1.3rem; text-transform:uppercase; }
  .modal-step{ display:none; }
  .modal-step.active{ display:block; }
  .modal-summary-row{ display:flex; justify-content:space-between; font-size:.82rem; color:var(--text-dim); padding:.55rem 0; border-bottom:1px solid var(--line-soft); }
  .modal-summary-row span:last-child{ color:var(--text); font-weight:600; }
  .modal-summary-total{ display:flex; justify-content:space-between; padding:.8rem 0 0; margin-top:.4rem; font-size:1rem; font-weight:700; }
  .modal-summary-total span:last-child{ color:var(--cyan); }
  .form-field{ margin-top:1rem; }
  .form-field label{ display:block; font-size:.7rem; color:var(--text-dim); text-transform:uppercase; letter-spacing:.06em; margin-bottom:.5rem; }
  .form-field input{
    width:100%; background:#000; border:1px solid var(--line); color:var(--text);
    padding:.75rem; border-radius:4px; font-family:'Rajdhani',sans-serif; font-size:.9rem;
  }
  .pay-method-row{ display:flex; gap:.6rem; margin-top:.5rem; }
  .pay-method{
    flex:1; border:1px solid var(--line); border-radius:4px; padding:.7rem; text-align:center;
    font-size:.75rem; color:var(--text-dim); cursor:pointer; transition:all .15s;
  }
  .pay-method:hover, .pay-method.selected{ border-color:var(--cyan); color:var(--text); }
  .modal-actions{ display:flex; justify-content:space-between; gap:1rem; margin-top:1.6rem; }
  .btn-ghost{
    background:none; border:1px solid var(--line); color:var(--text-dim);
    padding:.75rem 1.2rem; border-radius:4px; cursor:pointer; font-size:.8rem; text-transform:uppercase; letter-spacing:.04em;
  }
  .btn-primary{
    background:var(--cyan); color:#031014; border:none; font-family:'Archivo Black',sans-serif;
    padding:.75rem 1.4rem; border-radius:4px; cursor:pointer; font-size:.78rem; text-transform:uppercase; letter-spacing:.04em;
  }
  .modal-confirm{ text-align:center; padding:.5rem 0; }
  .modal-confirm .icon{ font-size:2.4rem; color:var(--cyan); margin-bottom:1rem; font-family:'Archivo Black',sans-serif; }
  .modal-confirm p{ color:var(--text-dim); font-size:.85rem; line-height:1.5; margin-bottom:1.5rem; }

  @media (max-width:900px){
    .sidebar{ width:240px; }
    .credit{ display:none; }
  }
</style>
</head>
<body>
<div class="stage" id="stageWrap">
  <div id="canvasHost"></div>
  <div class="vignette"></div>
  <div class="flash" id="flash"></div>

  <div class="topbar">
    <div class="logo">KAIDO<span>//</span>GARAGE</div>
    <div class="rating-wrap">
      <span class="hud-chip">BUILD RATING</span>
      <div class="rating-bars" id="ratingBars">
        <i></i><i></i><i></i><i></i><i></i>
      </div>
    </div>
  </div>

  <div class="sidebar">
    <div class="sb-section">
      <h3>Paint</h3>
      <div class="swatch-row" id="swatchRow">
        <div class="swatch active" style="background:#c81c2e" data-hex="#c81c2e" data-price="0" onclick="pickPaint(this,'#c81c2e',0)"></div>
        <div class="swatch" style="background:#0d0d0f" data-hex="#0d0d0f" data-price="0" onclick="pickPaint(this,'#0d0d0f',0)"></div>
        <div class="swatch" style="background:#e8e8e0" data-hex="#e8e8e0" data-price="0" onclick="pickPaint(this,'#e8e8e0',0)"></div>
        <div class="swatch" style="background:#0a3d91" data-hex="#0a3d91" data-price="15000" onclick="pickPaint(this,'#0a3d91',15000)"></div>
        <div class="swatch" style="background:#ffd400" data-hex="#ffd400" data-price="20000" onclick="pickPaint(this,'#ffd400',20000)"></div>
        <div class="swatch" style="background:#0f5c2e" data-hex="#0f5c2e" data-price="20000" onclick="pickPaint(this,'#0f5c2e',20000)"></div>
        <div class="swatch" style="background:#7a1fa2" data-hex="#7a1fa2" data-price="35000" onclick="pickPaint(this,'#7a1fa2',35000)"></div>
        <div class="swatch" style="background:#ff6a00" data-hex="#ff6a00" data-price="25000" onclick="pickPaint(this,'#ff6a00',25000)"></div>
      </div>
      <div class="custom-color-row">
        <input type="color" id="customColor" value="#c81c2e" oninput="onCustomColor(this.value)">
        <span class="custom-label">Custom hex (+ ৳40,000 bespoke mix)</span>
      </div>
      <div class="slider-block">
        <label>Brightness <span id="brightVal">100%</span></label>
        <input type="range" min="60" max="140" value="100" oninput="onBrightness(this.value)">
      </div>
    </div>

    <div class="sb-section">
      <h3>Finish</h3>
      <div class="finish-row" id="finishRow">
        <button class="finish-btn active" data-finish="gloss" data-price="0" onclick="setFinish('gloss', this, 0)">
          <span class="finish-btn-top"><span class="finish-swatch" style="background:linear-gradient(135deg,#fff,#888)"></span>Gloss</span>
          <span class="finish-price">Included</span>
        </button>
        <button class="finish-btn" data-finish="matte" data-price="85000" onclick="setFinish('matte', this, 85000)">
          <span class="finish-btn-top"><span class="finish-swatch" style="background:#5a5a5a"></span>Matte</span>
          <span class="finish-price">+ ৳85,000</span>
        </button>
        <button class="finish-btn" data-finish="metallic" data-price="55000" onclick="setFinish('metallic', this, 55000)">
          <span class="finish-btn-top"><span class="finish-swatch" style="background:linear-gradient(135deg,#d8d8d8,#8a8a8a)"></span>Metallic</span>
          <span class="finish-price">+ ৳55,000</span>
        </button>
        <button class="finish-btn" data-finish="chrome" data-price="180000" onclick="setFinish('chrome', this, 180000)">
          <span class="finish-btn-top"><span class="finish-swatch" style="background:linear-gradient(135deg,#fff,#4a90d9,#fff)"></span>Chrome</span>
          <span class="finish-price">+ ৳1,80,000</span>
        </button>
      </div>
    </div>

    <div class="sb-section">
      <h3>Rims</h3>
      <div class="part-row" id="rimRow"></div>
    </div>

    <div class="sb-section">
      <h3>Body Kit</h3>
      <div class="part-row">
        <div class="part-chip disabled">
          <div class="part-chip-name">Stock Body</div>
          <div class="part-chip-tag">Coming soon</div>
        </div>
      </div>
    </div>

    <div class="sb-section" id="spoilerSection">
      <h3>Spoiler</h3>
      <div class="part-row" id="spoilerRow"></div>
    </div>

    <div class="sb-section">
      <h3>Seats</h3>
      <div class="part-row">
        <div class="part-chip disabled">
          <div class="part-chip-name">Stock Seats</div>
          <div class="part-chip-tag">Coming soon</div>
        </div>
      </div>
    </div>

    <div class="sb-section">
      <h3>Price</h3>
      <div class="price-box">
        <div class="price-row"><span>Paint</span><span id="paintPriceRow">৳0</span></div>
        <div class="price-row"><span>Finish</span><span id="finishPriceRow">Included</span></div>
        <div class="price-total"><span>Total</span><span id="totalPriceRow">৳0</span></div>
        <button class="confirm-btn" onclick="openPayment()">Confirm & Pay</button>
      </div>
    </div>
  </div>

  <div class="camera-hud">
    <div class="angle-row">
      <button class="angle-btn active" onclick="setAngle('three', this)">3/4</button>
      <button class="angle-btn" onclick="setAngle('front', this)">Front</button>
      <button class="angle-btn" onclick="setAngle('side', this)">Side</button>
      <button class="angle-btn" onclick="setAngle('rear', this)">Rear</button>
    </div>
    <div class="spin-toggle" onclick="toggleSpin()">
      <div class="spin-dot on" id="spinDot"></div>
      <span id="spinLabel">Auto-rotate on</span>
    </div>
  </div>

  <button class="exit-view-btn" id="exitViewBtn" onclick="exitViewMode()">&larr; Exit View · Customize This Car</button>

  <div class="carousel-wrap">
    <div class="carousel-label-row">
      <div class="carousel-label">Select Car</div>
      <div class="carousel-arrows">
        <button class="carousel-arrow" id="carPrev" aria-label="Previous car">&#10094;</button>
        <button class="carousel-arrow" id="carNext" aria-label="Next car">&#10095;</button>
      </div>
    </div>
    <div class="carousel-viewport">
      <div class="carousel" id="carCarousel"></div>
    </div>
  </div>

  <div class="credit">
    3D models: <strong>"Lamborghini Aventador"</strong> by Outlaw Games™ (<a href="http://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener">CC BY-NC 4.0</a>)
    and <strong>"2018 Garage Mak Nissan S15 Silvia"</strong> by Reggie Mah / Ddiaz Design (<a href="http://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a>).
    Non-commercial educational use only.
  </div>

  <div id="loading">
    <span id="loadingText">LOADING GARAGE ASSET…</span>
    <div class="loadbar"><span></span></div>
  </div>
</div>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <button class="modal-close" onclick="closePayment()">&times;</button>

    <div class="modal-step active" id="payStep1">
      <div class="modal-eyebrow">Order Summary</div>
      <h3>Confirm Your Build</h3>
