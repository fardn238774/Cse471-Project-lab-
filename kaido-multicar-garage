  lipSpoiler: {
    name: 'Track Lip Spoiler',
    tag: 'Low-profile deck lip',
    elementId: 'modelDataSpoilerLip',
    // This scan's proportions are very different from the GT wing above -
    // extremely wide and flat (its own raw dimensions are roughly
    // 1521 x 303 x 160, vs the GT wing's roughly 3 x 1.9 x 4.7), more
    // like a low sport lip than a raised multi-strut wing. Starting from
    // the same tuned mount values as the GT wing since they share the
    // same mounting engine, but this one may need its own adjustment
    // once you see it - its shape is different enough that the same
    // numbers aren't guaranteed to land perfectly.
    widthRatio: 0.52,
    zInset: -0.004,
    mountOffsetY: -0.12,
    // This scan has no authored color or texture at all (checked the
    // raw file directly - the material has no baseColorFactor and no
    // baseColorTexture), so it renders plain white by default. Tinting
    // it black here since that's the color it was actually meant to be.
    forceColor: '#0d0d0d',
  }
};

function base64ToArrayBuffer(base64){
  const binaryString = atob(base64);
  const len = binaryString.length;
  const bytes = new Uint8Array(len);
  for (let i = 0; i < len; i++){
    bytes[i] = binaryString.charCodeAt(i);
  }
  return bytes.buffer;
}

function disposeMaterial(m){
  for (const key in m){
    const val = m[key];
    if (val && val.isTexture) val.dispose();
  }
  m.dispose();
}

function clearCurrentCar(){
  clearRimClones();
  clearSpoilerClone();
  hiddenWheelMeshes = [];
  wheelClusters = [];
  spoilerAnchor = null;
  if (currentModel){
    scene.remove(currentModel);
    currentModel.traverse(child => {
      if (child.isMesh){
        if (child.geometry) child.geometry.dispose();
        if (child.material){
          if (Array.isArray(child.material)) child.material.forEach(disposeMaterial);
          else disposeMaterial(child.material);
        }
      }
    });
    currentModel = null;
  }
  paintMaterials = [];
}

function loadCarById(carId){
  const cfg = carConfigs[carId];
  currentCarId = carId;
  loadingEl.style.display = 'flex';
  loadingTextEl.textContent = 'LOADING ' + cfg.name.toUpperCase() + '…';

  clearCurrentCar();

  const base64 = document.getElementById(cfg.elementId).textContent;
  const arrayBuffer = base64ToArrayBuffer(base64);
  const loader = new GLTFLoader();

  loader.parse(arrayBuffer, '', (gltf) => {
    const model = gltf.scene;

    const box = new THREE.Box3().setFromObject(model);
    const size = new THREE.Vector3();
    box.getSize(size);
    const maxDim = Math.max(size.x, size.y, size.z);
    const scale = 2.6 / maxDim;
    model.scale.setScalar(scale);
    model.updateMatrixWorld(true);

    const trustedBox = new THREE.Box3();
    let hasTrusted = false;

    model.traverse((child) => {
      if (child.isMesh){
        child.castShadow = true;
        child.receiveShadow = true;
        if (cfg.isPaintMesh(child)){
          paintMaterials.push(child.material);
        }
        if (cfg.isTrustedMesh(child)){
          trustedBox.expandByObject(child);
          hasTrusted = true;
        }
      }
    });

    if (!hasTrusted){ trustedBox.setFromObject(model); }

    const center = new THREE.Vector3();
    trustedBox.getCenter(center);
    model.position.x -= center.x;
    model.position.z -= center.z;
    model.position.y -= trustedBox.min.y;
    model.updateMatrixWorld(true);

    scene.add(model);
    currentModel = model;

    wheelClusters = computeWheelClusters(model, cfg);
    spoilerAnchor = findSpoilerAnchor(model, cfg);
    currentRimId = 'stock';
    document.querySelectorAll('#rimRow .part-chip').forEach(c => {
      c.classList.toggle('active', c.dataset.rim === 'stock');
    });
    currentSpoilerId = 'none';
    document.querySelectorAll('#spoilerRow .part-chip').forEach(c => {
      c.classList.toggle('active', c.dataset.spoiler === 'none');
    });
    clearSpoilerClone();
    const spoilerSectionEl = document.getElementById('spoilerSection');
    if (spoilerSectionEl){
      spoilerSectionEl.style.display = cfg.disableSpoiler ? 'none' : '';
    }

    const size3 = new THREE.Vector3();
    trustedBox.getSize(size3);
    modelRadius = Math.max(size3.x, size3.z) * 1.1;

    applyFinish(currentFinish);
    updatePaintMaterials();

    const positions = anglePositions(modelRadius);
    camera.position.copy(positions.three);
    controls.target.set(0, size3.y*0.35, 0);

    loadingEl.style.display = 'none';
  }, (err) => {
    loadingTextEl.textContent = 'COULD NOT LOAD MODEL';
    console.error(err);
  });
}

// --- Rim swap engine -------------------------------------------------
// Groups all meshes matched by cfg.isWheelMesh() into 4 world-space
// clusters (front-left/front-right/rear-left/rear-right) by sampling
// vertex positions and splitting on X (left/right) then Z (front/rear).
// Finds the single highest point on the car's exterior bodywork (paint,
// trim, carbon parts - excluding glass, interior, wheels/tires). For a
// car with a raised fixed rear wing (like the SVJ), that highest point
// IS the wing tip, so this gives us a reliable, assumption-free anchor
// for mounting a replacement spoiler - no need to guess which end of the
// car is "front" vs "rear" in its local coordinate system.
function findSpoilerAnchor(model, cfg){
  let maxY = -Infinity;
  const anchor = new THREE.Vector3(0, 0, 0);
  const tmp = new THREE.Vector3();
  model.updateMatrixWorld(true);
  model.traverse((child) => {
    if (!child.isMesh || !child.geometry) return;
    if (cfg.isWheelMesh && cfg.isWheelMesh(child)) return;
    if (cfg.isTireMesh && cfg.isTireMesh(child)) return;
    const mn = (child.material && child.material.name) || '';
    if (/glass|window|interior|seat|engine|plate|badge/i.test(mn)) return;
    const posAttr = child.geometry.attributes && child.geometry.attributes.position;
    if (!posAttr) return;
    const step = Math.max(1, Math.floor(posAttr.count / 400));
    for (let i = 0; i < posAttr.count; i += step){
      tmp.fromBufferAttribute(posAttr, i);
      tmp.applyMatrix4(child.matrixWorld);
      if (tmp.y > maxY){
        maxY = tmp.y;
        anchor.copy(tmp);
      }
    }
  });
  return anchor;
}

function computeWheelClusters(model, cfg){
  const pts = [];
  model.traverse((child) => {
    if (child.isMesh && cfg.isWheelMesh(child)){
      child.updateWorldMatrix(true, false);
      const posAttr = child.geometry.attributes.position;
      const step = Math.max(1, Math.floor(posAttr.count / 300));
      const v = new THREE.Vector3();
      for (let i = 0; i < posAttr.count; i += step){
        v.fromBufferAttribute(posAttr, i).applyMatrix4(child.matrixWorld);
        pts.push(v.clone());
      }
    }
  });
  if (!pts.length) return [];

  const cx = pts.reduce((s, p) => s + p.x, 0) / pts.length;
  const leftPts = pts.filter(p => p.x >= cx);
  const rightPts = pts.filter(p => p.x < cx);

  function splitZ(arr){
    if (!arr.length) return [[], []];
    const cz = arr.reduce((s, p) => s + p.z, 0) / arr.length;
    return [arr.filter(p => p.z >= cz), arr.filter(p => p.z < cz)];
  }
  const [lf, lr] = splitZ(leftPts);
  const [rf, rr] = splitZ(rightPts);

  function info(arr){
    if (!arr.length) return null;
    const box = new THREE.Box3();
    arr.forEach(p => box.expandByPoint(p));
    const center = box.getCenter(new THREE.Vector3());
    const size = box.getSize(new THREE.Vector3());
    // Don't assume the car's axle runs along world X - measure it. A wheel is
    // round, so two of the three box dimensions (the diameter, front-to-back
    // and top-to-bottom) will be roughly equal and much bigger than the third
    // (the tire's width, which runs along the actual axle). Whichever world
    // axis comes out smallest here IS the real axle direction for this car.
    const dims = [
      { vec: new THREE.Vector3(1, 0, 0), val: size.x },
      { vec: new THREE.Vector3(0, 1, 0), val: size.y },
      { vec: new THREE.Vector3(0, 0, 1), val: size.z },
    ];
    dims.sort((a, b) => a.val - b.val);
    const diameter = (dims[1].val + dims[2].val) / 2;
    return {
      center,
      diameter: diameter || 1,
      width: dims[0].val || diameter * 0.35,
      side: Math.sign(center.x) || 1,
      axleVec: dims[0].vec,
    };
  }
  return [info(lf), info(lr), info(rf), info(rr)].filter(Boolean);
}

function hideWheelAssembly(cfg){
  hiddenWheelMeshes = [];
  currentModel.traverse((child) => {
    if (child.isMesh && (cfg.isWheelMesh(child) || cfg.isTireMesh(child))){
      child.visible = false;
      hiddenWheelMeshes.push(child);
    }
  });
}

function showWheelAssembly(){
  hiddenWheelMeshes.forEach(m => { m.visible = true; });
  hiddenWheelMeshes = [];
}

function clearRimClones(){
  rimClones.forEach(o => { if (o.parent) o.parent.remove(o); });
  rimClones = [];
}

function loadRimTemplate(id, cb){
  if (rimTemplateCache[id]){ cb(rimTemplateCache[id]); return; }
  const opt = rimOptions[id];
  const base64 = document.getElementById(opt.elementId).textContent;
  const arrayBuffer = base64ToArrayBuffer(base64);
  const loader = new GLTFLoader();
  loader.parse(arrayBuffer, '', (gltf) => {
    const scene = gltf.scene;
    if (opt.excludeMaterials && opt.excludeMaterials.length){
      // Some scans carry stray leftover meshes (decals, background bits)
      // from the original scene they were cut from. Strip them out now so
      // they never render and never get included when we measure the
      // model's bounding box for scaling/alignment below.
      const toRemove = [];
      scene.traverse((child) => {
        if (child.isMesh && child.material && opt.excludeMaterials.includes(child.material.name)){
          toRemove.push(child);
        }
      });
      toRemove.forEach((m) => { if (m.parent) m.parent.remove(m); });
    }
    rimTemplateCache[id] = scene;
    cb(scene);
  }, (err) => console.error(err));
}

// Finds which local axis of the rim model is its thin "axle" axis
// (the one perpendicular to the wheel's face), the same way as above -
// whichever axis is thinnest is the axle, regardless of how the model
// happens to be authored/oriented.
function getAxleInfo(obj, forcedAxis){
  const box = new THREE.Box3().setFromObject(obj);
  const size = box.getSize(new THREE.Vector3());
  const center = box.getCenter(new THREE.Vector3());
  const dims = [
    { axis: 'x', vec: new THREE.Vector3(1, 0, 0), val: size.x },
    { axis: 'y', vec: new THREE.Vector3(0, 1, 0), val: size.y },
    { axis: 'z', vec: new THREE.Vector3(0, 0, 1), val: size.z },
  ];
  dims.sort((a, b) => a.val - b.val);
  // Most bare-rim scans are cleanly thin along one axis (the true axle),
  // so guessing "thinnest AABB dimension" works fine. Some scans (tire
  // tread detail, uneven scan noise) don't have one dimension that's
  // clearly thinnest, so a per-model override lets us pin the correct
  // axis instead of guessing wrong.
  let axleIdx = 0;
  if (forcedAxis){
    const found = dims.findIndex(d => d.axis === forcedAxis);
    if (found !== -1) axleIdx = found;
  }
  const otherDims = dims.filter((_, i) => i !== axleIdx);
  const diameter = (otherDims[0].val + otherDims[1].val) / 2;
  // `center` is the rim model's own geometric center in its local space.
  // Sketchfab exports are frequently not centered on their local origin
  // (the mesh can sit far from (0,0,0)), so we must remember this offset
  // and cancel it out later - otherwise the cloned wheel renders way off
  // to the side of the hub instead of centered on it ("floating").
  return { axleVec: dims[axleIdx].vec, diameter: diameter || 1, localCenter: center };
}

function applyCustomRim(cfg, template, opt){
  clearRimClones();
  const axle = getAxleInfo(template, opt && opt.axleAxis);
  const includesTire = !!(opt && opt.includesTire);
  const tireMat = new THREE.MeshStandardMaterial({ color: 0x0d0d0f, roughness: 0.9, metalness: 0.05 });

  wheelClusters.forEach((cluster) => {
    // If the model already comes with its own tire (rim + tire + brake as
    // one assembly), scale it to the wheel's full diameter. Otherwise
    // (bare rim only) reserve some diameter for a visible tire sidewall.
    const rimDiameter = includesTire
      ? cluster.diameter * (opt && opt.fitScale ? opt.fitScale : 1)
      : cluster.diameter * 0.8;

    const clone = template.clone(true);
    // Rotate the rim's own axle axis to match THIS car's real axle
    // direction (front and rear wheels share the same axle axis, but we
    // compute it fresh per wheel in case the car isn't perfectly axis-aligned).
    const quat = new THREE.Quaternion().setFromUnitVectors(axle.axleVec, cluster.axleVec);
    clone.quaternion.copy(quat);
    const scaleFactor = rimDiameter / axle.diameter;
    clone.scale.setScalar(scaleFactor);
    if (cluster.side < 0) clone.scale.x *= -1;

    // Where does the model's own geometric center land after the scale+rotation
    // above is applied (still relative to the clone's own origin)? Shift the
    // clone backwards by that amount so the *visual center* of the wheel -
    // not its arbitrary local origin - lands exactly on the hub position.
    const centerOffset = axle.localCenter.clone()
      .multiply(clone.scale)
      .applyQuaternion(clone.quaternion);
    clone.position.copy(cluster.center).sub(centerOffset);

    clone.traverse((c) => {
      if (c.isMesh){
        c.castShadow = true;
        c.receiveShadow = true;
        // A mirrored (negative-scale) clone reverses its triangle winding,
        // which would make the flipped side invisible under backface
        // culling. Render both faces so the mirrored wheel doesn't look
        // like it's missing chunks of geometry.
        const mats = Array.isArray(c.material) ? c.material : [c.material];
        mats.forEach(m => { if (m) m.side = THREE.DoubleSide; });
      }
    });
    scene.add(clone);
    rimClones.push(clone);

    if (includesTire) return;

    // The rim model itself is bare metal with no tire, so build a simple
    // rubber tire ring that fills the gap between the rim's outer edge and
    // the wheel's actual total diameter, oriented the same way as the rim.
    const outerR = cluster.diameter / 2;
    const innerR = rimDiameter / 2;
    const tubeR = Math.max((outerR - innerR) / 2, 0.001);
    const ringR = (outerR + innerR) / 2;
    const tireWidth = Math.min(cluster.width, tubeR * 2.1);
    const tireGeo = new THREE.TorusGeometry(ringR, tubeR, 20, 48);
    tireGeo.scale(1, 1, THREE.MathUtils.clamp(tireWidth / (tubeR * 2), 0.4, 1.6));
    const tire = new THREE.Mesh(tireGeo, tireMat);
    tire.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), cluster.axleVec);
    tire.position.copy(cluster.center);
    tire.castShadow = true;
    tire.receiveShadow = true;
    scene.add(tire);
    rimClones.push(tire);
  });
}

// Smoothly moves the camera to a close-up "inspection" angle on the
// frontmost wheel, similar to a tuner-photo wheel close-up.
function focusOnHeroWheel(){
  if (!wheelClusters.length) return;
  let hero = wheelClusters[0];
  wheelClusters.forEach((c) => { if (c.center.z > hero.center.z) hero = c; });

  const r = hero.diameter / 2;
  const outward = new THREE.Vector3(hero.side, 0, 0);
  const camPos = hero.center.clone()
    .add(outward.clone().multiplyScalar(r * 2.6))
    .add(new THREE.Vector3(0, r * 1.3, r * 1.6));
  const target = hero.center.clone().add(outward.clone().multiplyScalar(-r * 0.15));

  document.querySelectorAll('.angle-btn').forEach(b => b.classList.remove('active'));
  tweenStart.copy(camera.position);
  tweenEnd.copy(camPos);
  tweenTargetStart.copy(controls.target);
  tweenTargetEnd.copy(target);
  tweenT = 0;
  tweenActive = true;
  autoSpin = false;
  document.getElementById('spinDot').classList.remove('on');
  document.getElementById('spinLabel').textContent = 'Auto-rotate off';
}

window.selectRim = function(id, el){
  document.querySelectorAll('#rimRow .part-chip').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  currentRimId = id;
  const cfg = carConfigs[currentCarId];

  if (id === 'stock'){
    showWheelAssembly();
    clearRimClones();
  } else {
    hideWheelAssembly(cfg);
    const opt = rimOptions[id];
    loadRimTemplate(id, (tmpl) => applyCustomRim(cfg, tmpl, opt));
  }
  focusOnHeroWheel();
};

function buildRimRow(){
  const wrap = document.getElementById('rimRow');
  Object.keys(rimOptions).forEach((id) => {
    const opt = rimOptions[id];
    const chip = document.createElement('div');
    chip.className = 'part-chip' + (id === 'stock' ? ' active' : '');
    chip.dataset.rim = id;
    chip.innerHTML = `
      <div class="part-chip-name">${opt.name}</div>
      <div class="part-chip-tag">${opt.tag}</div>
    `;
    chip.onclick = () => window.selectRim(id, chip);
    wrap.appendChild(chip);
  });
}
buildRimRow();

// --- Spoiler swap engine -----------------------------------------------
// Same overall approach as the rim engine, but simpler: there's no
// existing spoiler mesh on either car to hide/detect, so we just mount
// the chosen part relative to the car's own current bounding box (which
// is already scaled + centered by loadCarById) rather than hardcoding
// per-car coordinates. That keeps it working automatically for any car
// added later, same as the rim system does for wheels.

function loadSpoilerTemplate(id, cb){
  if (spoilerTemplateCache[id]){ cb(spoilerTemplateCache[id]); return; }
  const opt = spoilerOptions[id];
  const base64 = document.getElementById(opt.elementId).textContent;
  const arrayBuffer = base64ToArrayBuffer(base64);
  const loader = new GLTFLoader();
  loader.parse(arrayBuffer, '', (gltf) => {
    const partScene = gltf.scene;
    if (opt.excludeMaterials && opt.excludeMaterials.length){
      const toRemove = [];
      partScene.traverse((child) => {
        if (child.isMesh && child.material && opt.excludeMaterials.includes(child.material.name)){
          toRemove.push(child);
        }
      });
      toRemove.forEach((m) => { if (m.parent) m.parent.remove(m); });
    }
    spoilerTemplateCache[id] = partScene;
    cb(partScene);
  }, (err) => console.error(err));
}

function clearSpoilerClone(){
  if (spoilerClone){
    scene.remove(spoilerClone);
    spoilerClone.traverse((child) => {
      if (child.isMesh){
        if (child.geometry) child.geometry.dispose();
        if (child.material){
          if (Array.isArray(child.material)) child.material.forEach(disposeMaterial);
          else disposeMaterial(child.material);
        }
      }
    });
    spoilerClone = null;
  }
}

function applySpoiler(opt, template){
  clearSpoilerClone();

  const clone = template.clone(true);
  clone.traverse((child) => {
    if (child.isMesh){
      child.castShadow = true;
      child.receiveShadow = true;
      // Some scans don't carry an authored color/texture at all and
      // render plain white by default - clone the material (so we never
      // mutate the cached template shared by future selections) and
      // tint it if this part config asks for it.
      if (opt.forceColor){
        const mat = Array.isArray(child.material) ? child.material.map(m => m.clone()) : child.material.clone();
        if (Array.isArray(mat)) mat.forEach(m => m.color.set(opt.forceColor));
        else mat.color.set(opt.forceColor);
        child.material = mat;
      }
    }
  });

  // Measure the part's own authored size before any scaling, so we can
  // work out a scale factor relative to the car regardless of whatever
  // arbitrary units it was modeled in.
  const rawBox = new THREE.Box3().setFromObject(clone);
  const rawSize = rawBox.getSize(new THREE.Vector3());

  // The car model is already scaled + centered on the origin at this
  // point (loadCarById does that on load), so its live bounding box
  // directly gives us real mount coordinates to target.
  const carBox = new THREE.Box3().setFromObject(currentModel);
  const carSize = carBox.getSize(new THREE.Vector3());
  const carCenter = carBox.getCenter(new THREE.Vector3());

  // A stock integrated wing (like the one already on the car's tail) is
  // a fairly compact part - nowhere near the full width of the car - so
  // this default is deliberately conservative rather than a full-width
  // GT wing.
  const widthRatio = opt.widthRatio !== undefined ? opt.widthRatio : 0.42;
  const zInset = opt.zInset !== undefined ? opt.zInset : 0.05;

  let scaleFactor = (carSize.x * widthRatio) / (rawSize.x || 1);

  // Safety net: whatever the scan's raw proportions are, never let the
  // mounted part end up bigger than the car itself in any dimension.
  // This is what actually guards against a wildly oversized result if
  // the width-based scale factor alone under- or over-shoots for a
  // particular scan's proportions.
  const maxScaleForHeight = (carSize.y * 0.45) / (rawSize.y || 1);
  const maxScaleForDepth = (carSize.z * 0.4) / (rawSize.z || 1);
  scaleFactor = Math.min(scaleFactor, maxScaleForHeight, maxScaleForDepth);

  // Per-car size adjustment, scoped to just the car that asked for it -
  // applied after the safety clamp above since this is an intentional
  // request to size up beyond the generic cap, not a bug to guard against.
  const carSpoilerScaleBoost = (carConfigs[currentCarId] && carConfigs[currentCarId].spoilerScaleBoost) || 1;
  scaleFactor *= carSpoilerScaleBoost;

  // Which way is "further back, away from the cabin"? Rather than assume
  // a world axis direction, read it off the measured anchor (the car's
  // own highest point, i.e. the existing wing tip) relative to the car's
  // center - whichever side that anchor sits on IS the rear, by
  // definition, for this specific model.
  const anchor = spoilerAnchor || new THREE.Vector3(carCenter.x, carBox.max.y, carBox.max.z);
  // Per-car override for cases where the measured anchor still ends up
  // on the wrong end for a specific car - scoped so it never affects
  // any other car's (already-correct) direction.
  const carRearFlip = (carConfigs[currentCarId] && carConfigs[currentCarId].spoilerRearFlip) ? -1 : 1;
  const rearSign = (Math.sign(anchor.z - carCenter.z) || 1) * carRearFlip;
  // This wing's own local geometry has its blade trailing toward local
  // -Z and its mount/struts toward local +Z. A 180deg spin is needed
  // whenever the measured rear direction is +Z, so the blade ends up
  // pointing away from the car (toward the rear) instead of into the cabin.
  const autoRotationY = rearSign > 0 ? Math.PI : 0;
  const rotationY = opt.rotationY !== undefined ? opt.rotationY : autoRotationY;

  clone.position.set(0, 0, 0);
  clone.rotation.set(0, rotationY, 0);
  clone.scale.setScalar(scaleFactor);
  clone.updateMatrixWorld(true);

  // Re-measure after scale/rotation to find where the part's own
  // geometric center and bottom edge actually landed, then shift it so
  // the strut base sits flush on the target mount height, centered on
  // the car's centerline, at the target depth. (Sketchfab scans are
  // rarely centered on their own local origin, so this offset-cancelling
  // step is necessary rather than trusting position (0,0,0) to be right.)
  const scaledBox = new THREE.Box3().setFromObject(clone);
  const scaledCenter = scaledBox.getCenter(new THREE.Vector3());

  const targetX = carCenter.x;
  // Mount height is tied to the anchor's own measured Y - the actual
  // highest sampled point on the car's real surface - plus a small
  // configurable nudge, rather than a fixed fraction of total car
  // height. A fixed fraction happened to work for the Lambo (whose
  // fixed wing really does sit around there) but isn't a safe bet for
  // an ordinary roofline. Lowered the nudge here since the wing was
  // floating just above the actual mount point with a visible gap in
  // the strut.
  const mountOffsetY = opt.mountOffsetY !== undefined ? opt.mountOffsetY : 0.02;
  // Per-car adjustment on top of the per-part mount tuning above - this
  // is how a height tweak can be scoped to just one specific car
  // without touching the shared numbers every other car also uses.
  const carSpoilerBoost = (carConfigs[currentCarId] && carConfigs[currentCarId].spoilerHeightBoost) || 0;
  const targetY = anchor.y + carSize.y * (mountOffsetY + carSpoilerBoost);
  // Mount right at (and a touch past) the measured anchor point - the
  // car's own existing high point - rather than a guessed world-axis end.
  const carSpoilerZBoost = (carConfigs[currentCarId] && carConfigs[currentCarId].spoilerZBoost) || 0;
  const zInsetTotal = Math.max(0, Math.abs(zInset) + carSpoilerZBoost);
  const targetZ = anchor.z + rearSign * carSize.z * zInsetTotal;

  clone.position.x += targetX - scaledCenter.x;
  clone.position.z += targetZ - scaledCenter.z;
  clone.position.y += targetY - scaledBox.min.y;
  clone.updateMatrixWorld(true);

  scene.add(clone);
  spoilerClone = clone;

  return { mountPoint: new THREE.Vector3(targetX, targetY, targetZ), span: carSize.x * widthRatio };
}

function focusOnSpoiler(mount){
  const r = Math.max(mount.span, 0.6) / 2;
  // Car is always centered at z=0 (loadCarById guarantees this), so the
  // mount point's own z sign tells us which way is "outward, away from
  // the car" - approach the camera from that same side rather than
  // assuming a fixed world direction.
  const outwardZ = Math.sign(mount.mountPoint.z) || 1;
  const camPos = mount.mountPoint.clone().add(new THREE.Vector3(r * 1.4, r * 1.3, outwardZ * r * 2.1));
  const target = mount.mountPoint.clone().add(new THREE.Vector3(0, r * 0.5, 0));

  document.querySelectorAll('.angle-btn').forEach(b => b.classList.remove('active'));
  tweenStart.copy(camera.position);
  tweenEnd.copy(camPos);
  tweenTargetStart.copy(controls.target);
  tweenTargetEnd.copy(target);
  tweenT = 0;
  tweenActive = true;
  autoSpin = false;
  document.getElementById('spinDot').classList.remove('on');
  document.getElementById('spinLabel').textContent = 'Auto-rotate off';
}

window.selectSpoiler = function(id, el){
  document.querySelectorAll('#spoilerRow .part-chip').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  currentSpoilerId = id;

  if (id === 'none'){
    clearSpoilerClone();
    const carBox = new THREE.Box3().setFromObject(currentModel);
    const carSize = carBox.getSize(new THREE.Vector3());
    const carCenter = carBox.getCenter(new THREE.Vector3());
    const anchor = spoilerAnchor || new THREE.Vector3(carCenter.x, carBox.max.y, carBox.max.z);
    focusOnSpoiler({
      mountPoint: new THREE.Vector3(carCenter.x, anchor.y, anchor.z),
      span: carSize.x * 0.42
    });
  } else {
    const opt = spoilerOptions[id];
    loadSpoilerTemplate(id, (tmpl) => {
      const mount = applySpoiler(opt, tmpl);
      focusOnSpoiler(mount);
    });
  }
};

function buildSpoilerRow(){
  const wrap = document.getElementById('spoilerRow');
  Object.keys(spoilerOptions).forEach((id) => {
    const opt = spoilerOptions[id];
    const chip = document.createElement('div');
    chip.className = 'part-chip' + (id === 'none' ? ' active' : '');
    chip.dataset.spoiler = id;
    chip.innerHTML = `
      <div class="part-chip-name">${opt.name}</div>
      <div class="part-chip-tag">${opt.tag}</div>
    `;
    chip.onclick = () => window.selectSpoiler(id, chip);
    wrap.appendChild(chip);
  });
}
buildSpoilerRow();

function selectCarCard(id, card){
  document.querySelectorAll('#carCarousel .build-card').forEach(x => x.classList.remove('active'));
  card.classList.add('active');
}

window.exitViewMode = function(){
  document.body.classList.remove('view-mode');
};

function enterViewMode(id, card){
  selectCarCard(id, card);
  document.body.classList.add('view-mode');
  if (currentCarId !== id) loadCarById(id);
};

function buildCarCarousel(){
  const wrap = document.getElementById('carCarousel');
  Object.keys(carConfigs).forEach((id) => {
    const cfg = carConfigs[id];
    const card = document.createElement('div');
    card.className = 'build-card' + (id === 'lambo' ? ' active' : '');
    card.innerHTML = `
      <div class="build-swatch car-swatch" style="background:${cfg.swatchColor}">${cfg.badge}</div>
      <div class="build-name">${cfg.name}</div>
      <div class="build-tag">${cfg.tag}</div>
      <button type="button" class="view-btn">View Car</button>
    `;
    card.querySelector('.view-btn').addEventListener('click', (e) => {
      e.stopPropagation();
      enterViewMode(id, card);
    });
    card.addEventListener('click', () => {
      const changingCar = currentCarId !== id;
      selectCarCard(id, card);
      exitViewMode();
      if (changingCar) loadCarById(id);
    });
    wrap.appendChild(card);
  });
  setupCarouselSlider();
}

let carouselIndex = 0;
function setupCarouselSlider(){
  const prevBtn = document.getElementById('carPrev');
  const nextBtn = document.getElementById('carNext');
  prevBtn.addEventListener('click', () => { carouselIndex--; updateCarouselTransform(); });
  nextBtn.addEventListener('click', () => { carouselIndex++; updateCarouselTransform(); });
  window.addEventListener('resize', updateCarouselTransform);
  updateCarouselTransform();
}

function updateCarouselTransform(){
  const track = document.getElementById('carCarousel');
  const viewport = track.parentElement;
  const firstCard = track.children[0];
  const prevBtn = document.getElementById('carPrev');
  const nextBtn = document.getElementById('carNext');
  if (!firstCard){
    prevBtn.disabled = true; nextBtn.disabled = true;
    return;
  }
  const gap = 0.8 * parseFloat(getComputedStyle(document.documentElement).fontSize);
  const cardWidth = firstCard.getBoundingClientRect().width + gap;
  const visibleCount = Math.max(1, Math.floor((viewport.clientWidth + gap) / cardWidth));
  const maxIndex = Math.max(0, track.children.length - visibleCount);
  carouselIndex = Math.min(Math.max(carouselIndex, 0), maxIndex);
  track.style.transform = `translateX(-${carouselIndex * cardWidth}px)`;
  prevBtn.disabled = carouselIndex <= 0;
  nextBtn.disabled = carouselIndex >= maxIndex;
}
buildCarCarousel();
updatePriceDisplay();

function onResize(){
  camera.aspect = stage.clientWidth / stage.clientHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(stage.clientWidth, stage.clientHeight);
}
window.addEventListener('resize', onResize);

function animate(){
  requestAnimationFrame(animate);

  if (tweenActive){
    tweenT += 0.035;
    if (tweenT >= 1){ tweenT = 1; tweenActive = false; }
    const eased = 1 - Math.pow(1 - tweenT, 3);
    camera.position.lerpVectors(tweenStart, tweenEnd, eased);
    controls.target.lerpVectors(tweenTargetStart, tweenTargetEnd, eased);
  }

  controls.autoRotate = autoSpin && !tweenActive;
  controls.autoRotateSpeed = 1.6;
  controls.update();
  renderer.render(scene, camera);
}
animate();

