function updatePaintMaterials(){
  paintMaterials.forEach(m => {
    m.map = null;
    const c = new THREE.Color(currentColorHex);
    c.multiplyScalar(brightnessFactor);
    m.color.copy(c);
    m.needsUpdate = true;
