let tweenActive = false;
let tweenStart = new THREE.Vector3();
let tweenEnd = new THREE.Vector3();
let tweenTargetStart = new THREE.Vector3();
let tweenTargetEnd = new THREE.Vector3();
let tweenT = 0;

function anglePositions(r){
  return {
    front: new THREE.Vector3(0, 0.55*r*0.5, r*1.15),
    side:  new THREE.Vector3(r*1.15, 0.55*r*0.5, 0),
    rear:  new THREE.Vector3(0, 0.55*r*0.5, -r*1.15),
    three: new THREE.Vector3(r*0.85, 0.65*r*0.5, r*0.85),
  };
}

window.setAngle = function(name, btn){
  document.querySelectorAll('.angle-btn').forEach(b => b.classList.remove('active'));
  if(btn) btn.classList.add('active');
  const positions = anglePositions(modelRadius);
  tweenStart.copy(camera.position);
  tweenEnd.copy(positions[name]);
  tweenTargetStart.copy(controls.target);
  tweenTargetEnd.set(0, controls.target.y, 0);
  tweenT = 0;
  tweenActive = true;
  autoSpin = false;
  document.getElementById('spinDot').classList.remove('on');
  document.getElementById('spinLabel').textContent = 'Auto-rotate off';
};

